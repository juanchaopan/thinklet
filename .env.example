# Copy to .env for local development. Task loads .env into every command it
# runs, and Docker Compose reads it for docker-compose.yml. The values work
# with the services in docker-compose.yml; staging values live in GitHub.

# Host ports of the Docker Compose services
POSTGRES_PORT=5432
S3_PORT=8333
REDIS_PORT=6379
MOCK_OIDC_PORT=8080

# api
PORT=3000
DATABASE_URL=postgresql://thinklet:thinklet@127.0.0.1:5432/thinklet
MIGRATION_DATABASE_URL=postgresql://thinklet:thinklet@127.0.0.1:5432/thinklet
S3_ENDPOINT=http://127.0.0.1:8333
S3_REGION=us-east-1
S3_BUCKET=thinklet
S3_ACCESS_KEY_ID=thinklet
S3_SECRET_ACCESS_KEY=thinklet-secret
S3_FORCE_PATH_STYLE=true
# The Valkey in docker-compose.yml (on REDIS_PORT), which has no password;
# staging's Redis takes a rediss:// address with one.
REDIS_URL=redis://127.0.0.1:6379
# The request header, in lowercase, that the api takes the client's IP
# address from. On staging the platform's proxy writes it; locally the proxy
# of `ng serve` adds it to X-Forwarded-For, and the tests send it themselves.
CLIENT_IP_HEADER=x-forwarded-for

# Login: the mock OIDC provider in docker-compose.yml (on MOCK_OIDC_PORT),
# which accepts any client id and secret. Both the browser and the api reach
# the issuer at this one address.
OIDC_ISSUER=http://localhost:8080/default
OIDC_CLIENT_ID=thinklet-local
OIDC_CLIENT_SECRET=thinklet-local-secret
# The origin the browser opens: `ng serve` on port 4200.
APP_ORIGIN=http://localhost:4200
# The ES256 private key, as a JWK, that signs the login JWTs. No key is kept
# in this file; `pnpm exec task jwt-key` prints a new one as a line to put
# here instead.
JWT_SIGNING_KEY=
# The master key, 32 random bytes in base64, from which the api derives the
# keys that encrypt children's personal data. No key is kept in this file;
# `pnpm exec task child-data-key` prints a new one as a line to put here
# instead.
CHILD_DATA_KEY=

# Account deletion: Authing's management API and its user:deleted webhook.
# Locally the stand-in service from apps/api/test/support plays Authing on
# AUTHING_STUB_PORT. It talks to nothing else, so the pool id and both
# secrets are fixed local values: it accepts this pool id and secret, and
# calls the api's webhook with this webhook secret.
AUTHING_STUB_PORT=8090
AUTHING_MANAGEMENT_ORIGIN=http://127.0.0.1:${AUTHING_STUB_PORT}
AUTHING_USER_POOL_ID=thinklet-local
AUTHING_USER_POOL_SECRET=thinklet-local-user-pool-secret
AUTHING_WEBHOOK_SECRET=thinklet-local-webhook-secret

# web: where `ng serve` forwards /api (the api above, on PORT)
API_ORIGIN=http://localhost:3000
