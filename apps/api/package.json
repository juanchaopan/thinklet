    "@thinklet/contracts": "workspace:*",
    "cookie-parser": "1.4.7",
    "drizzle-orm": "0.45.4",
    "jose": "6.2.18",
    "nestjs-pino": "5.3.2",
    "openid-client": "6.9.0",
    "pg": "8.23.1",
    "pino": "10.4.0",
