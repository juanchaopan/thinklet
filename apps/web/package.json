{
  "name": "web",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": "26.13.1"
  },
  "scripts": {
    "ng": "ng",
    "start": "ng serve",
    "build": "ng build",
    "watch": "ng build --watch --configuration development",
    "typecheck": "tsc --noEmit -p tsconfig.app.json && tsc --noEmit -p tsconfig.spec.json && tsc --noEmit -p scripts/tsconfig.json && tsc --noEmit -p tsconfig.config.json",
    "test:unit": "vitest run --config scripts/vitest.config.ts",
    "test:component": "ng test --watch=false --coverage",
    "vercel-config": "node scripts/write-vercel-config.ts"
  },
  "dependencies": {
    "@angular/cdk": "22.3.0",
    "@angular/common": "22.3.0",
    "@angular/compiler": "22.3.0",
    "@angular/core": "22.3.0",
    "@angular/forms": "22.3.0",
    "@angular/platform-browser": "22.3.0",
    "@angular/router": "22.3.0",
    "qrcode": "1.5.4",
    "rxjs": "7.8.2",
    "tslib": "2.9.1"
  },
  "devDependencies": {
    "@angular/build": "22.3.0",
    "@angular/cli": "22.3.0",
    "@angular/compiler-cli": "22.3.0",
    "@tailwindcss/postcss": "4.3.5",
    "@testing-library/angular": "19.6.0",
    "@testing-library/dom": "10.4.2",
    "@types/node": "26.6.6",
    "@types/qrcode": "1.5.6",
    "@vitest/browser-playwright": "5.1.1",
    "@vitest/coverage-v8": "5.1.1",
    "axe-core": "4.14.1",
    "msw": "3.0.7",
    "playwright": "1.65.1",
    "postcss": "8.5.33",
    "tailwindcss": "4.3.5",
    "vitest": "5.1.1"
  }
}
